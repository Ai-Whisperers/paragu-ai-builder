{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salud",
  "title": "Health / Medical Business Input Schema",
  "description": "Additional fields for clinics, practitioners, and health service providers",
  "allOf": [{ "$ref": "base-business" }],
  "properties": {
    "specialties": {
      "type": "array",
      "description": "Medical specialties offered",
      "items": { "type": "string" }
    },
    "acceptedInsurances": {
      "type": "array",
      "description": "Insurance providers / prepagas accepted",
      "items": { "type": "string" }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "string" },
          "duration": { "type": "integer", "description": "Consult length in minutes" }
        }
      }
    },
    "credentials": {
      "type": "array",
      "description": "Professional registrations (CMP, Universidad, etc.) — public-facing",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "emergencyService": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "phone": { "type": "string" },
        "hours": { "type": "string" }
      }
    }
  },
  "inputForm": {
    "priority1": ["businessName", "contact.phone", "location.address", "specialties", "services"],
    "priority2": ["team", "credentials", "acceptedInsurances", "emergencyService", "branding.logoUrl"],
    "priority3": ["seo.googleBusinessProfileUrl", "faq", "testimonials", "hours"]
  }
}
