{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vertical-food-beverage",
  "allOf": [{ "$ref": "base-business" }],
  "type": "object",
  "properties": {
    "cuisineType": { "type": "string" },
    "menuCategories": { "type": "array", "items": { "type": "string" } },
    "deliveryPlatforms": {
      "type": "array",
      "items": { "type": "string", "enum": ["pedidos_ya", "monchis", "rappi", "ubereats", "own"] }
    },
    "dietaryOptions": { "type": "array", "items": { "type": "string" } }
  }
}
