      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "makesOffer": [
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Corte y Peinado"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Manicura y Pedicura"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Maquillaje Profesional"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Tratamientos Faciales"}}
      ],
      "areaServed": {"@type": "City", "name": "{{city}}"}
    },
