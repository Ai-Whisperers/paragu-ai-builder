{
  "id": "pilates",
  "nameEs": "Estudio de Pilates",
  "nameEn": "Pilates Studio",
  "verticalId": "service-booking",
  "extends": "gimnasio",
  "tokens": "pilates",
  "features": {
    "onlineBooking": { "enabled": true, "method": "whatsapp" },
    "classSchedule": { "enabled": true, "filterByType": true, "filterByInstructor": true },
    "membershipPlans": { "enabled": true, "highlightPopular": true },
    "freeTrial": { "enabled": true, "days": 1, "label": "Clase de prueba bonificada" },
    "staffProfiles": { "enabled": true, "label": "Instructoras", "showCertifications": true }
  },
  "serviceCategories": ["reformer", "mat", "tower", "post_rehab", "prenatal", "personal"],
  "seo": {
    "schemaType": "HealthClub",
    "titleTemplate": "{{businessName}} - Pilates en {{city}}",
    "descriptionTemplate": "Pilates Reformer, Mat, Tower y rehabilitacion en {{city}}. Grupos reducidos.",
    "keywords": ["pilates {{city}}", "pilates reformer {{city}}", "pilates mat {{city}}", "pilates rehabilitacion {{city}}"]
  },
  "nav": {
    "items": ["Inicio", "Metodo", "Horarios", "Planes", "Contacto"],
    "cta": { "text": "Clase de Prueba", "action": "freeTrial" }
  },
  "hero": {
    "style": "image",
    "headlineTemplate": "{{businessName}} - Pilates autentico",
    "subheadlineTemplate": "Reformer, Mat y Tower en {{city}}. Grupos reducidos, atencion personalizada.",
    "ctaPrimary": { "text": "Clase de Prueba", "action": "whatsapp" },
    "ctaSecondary": { "text": "Ver Horarios", "action": "scrollTo:classSchedule" }
  }
}
