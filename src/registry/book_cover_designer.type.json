        "header",
        "hero",
        "services",
        "portfolio",
        "product-catalog",
        "creative-commission-process",
        "pricing-range",
        "testimonials",
        "faq-categorized",
        "intake-questionnaire",
        "contact",
        "footer",
        "whatsapp-float"
      ],
      "requiredSections": ["header", "hero", "services", "portfolio", "contact", "footer"]
