  "defaultPalette": "optionA",
  "typography": {
    "heading": "'Space Grotesk', 'Inter', sans-serif",
    "body": "'Inter', sans-serif"
  },
  "googleFonts": [
    "Inter:wght@400;500;600;700",
    "Space Grotesk:wght@500;600;700"
