{
  "name": "Banda Musical - Dark Metal",
  "extends": "base",
  "theme": "dark",
  "mood": ["aggressive", "dark", "intense", "raw", "underground"],

  "palettes": {
    "optionA": {
      "name": "Blood Red Dark",
      "colors": {
        "primary": "#8b0000",
        "secondary": "#dc2626",
        "accent": "#450a0a",
        "background": "#0a0a0a",
        "surface": "#1a1a1a",
        "surfaceLight": "#2a2a2a",
        "text": "#f5f5f5",
        "textLight": "#a3a3a3",
        "textMuted": "#737373",
        "success": "#16a34a",
        "error": "#dc2626",
        "warning": "#d97706",
        "secondaryHover": "#ef4444"
      }
    },
    "optionB": {
      "name": "Crimson Abyss",
      "colors": {
        "primary": "#7f1d1d",
        "secondary": "#b91c1c",
        "accent": "#1e1e1e",
        "background": "#050505",
        "surface": "#141414",
        "surfaceLight": "#262626",
        "text": "#fafafa",
        "textLight": "#a3a3a3",
        "textMuted": "#6b7280",
        "success": "#059669",
        "error": "#ef4444",
        "warning": "#f59e0b",
        "secondaryHover": "#dc2626"
      }
    },
    "optionC": {
      "name": "Ember Black",
      "colors": {
        "primary": "#991b1b",
        "secondary": "#f97316",
        "accent": "#292524",
        "background": "#0c0c0c",
        "surface": "#1c1917",
        "surfaceLight": "#292524",
        "text": "#fafaf9",
        "textLight": "#a8a29e",
        "textMuted": "#78716c",
        "success": "#10b981",
        "error": "#ef4444",
        "warning": "#f59e0b",
        "secondaryHover": "#fb923c"
      }
    }
  },

  "defaultPalette": "optionA",

  "typography": {
    "heading": "'Bebas Neue', 'Impact', 'Arial Black', sans-serif",
    "body": "'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "accent": "'Bebas Neue', 'Impact', sans-serif",
    "headingWeight": "700",
    "bodyWeight": "400",
    "headingStyle": "normal",
    "textTransform": "uppercase",
    "lineHeight": {
      "heading": "1.0",
      "body": "1.65",
      "relaxed": "1.8"
    },
    "letterSpacing": {
      "heading": "0.05em",
      "body": "0",
      "wide": "0.1em"
    },
    "fontSize": {
      "h1": "clamp(3rem, 8vw, 6rem)",
      "h2": "clamp(2rem, 5vw, 3.5rem)",
      "h3": "clamp(1.25rem, 3vw, 2rem)",
      "body": "1rem"
    }
  },

  "spacing": {
    "section": {
      "desktop": "96px",
      "tablet": "72px",
      "mobile": "48px"
    },
    "contentGap": "24px",
    "cardPadding": "24px"
  },

  "effects": {
    "heroOverlay": "linear-gradient(rgba(0,0,0,0.8), rgba(139,0,0,0.3))",
    "cardHover": "0 0 20px rgba(220,38,38,0.3)",
    "glitch": {
      "enabled": true,
      "rgbSplit": "2px"
    },
    "noise": {
      "enabled": true,
      "opacity": "0.03"
    },
    "borderGlow": "0 0 6px rgba(220,38,38,0.5)",
    "dividerStyle": "solid 1px rgba(220,38,38,0.2)"
  },

  "images": {
    "hero": { "width": 1920, "height": 1080, "maxSizeKb": 200 },
    "gallery": { "width": 1200, "height": 1200, "maxSizeKb": 150 },
    "thumbnail": { "width": 400, "height": 400, "maxSizeKb": 50 },
    "team": { "width": 600, "height": 600, "maxSizeKb": 80 },
    "format": "webp",
    "fallbackFormat": "jpeg"
  },

  "cssCustom": "--section-divider: linear-gradient(90deg, transparent, rgba(220,38,38,0.3), transparent); --glow-primary: 0 0 15px rgba(139,0,0,0.4); --glow-secondary: 0 0 15px rgba(220,38,38,0.3); --header-bg: rgba(10,10,10,0.95); --border-color: rgba(220,38,38,0.15); --btn-primary-hover-bg: #991b1b; --btn-secondary-border: rgba(220,38,38,0.5);"
}
