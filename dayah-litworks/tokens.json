        "accent": "#6691c8",
        "accentForeground": "#0f0f1a",
        "background": "#0f0f1a",
        "surface": "#16213e",
        "surfaceLight": "#1a1a2e",
        "text": "#eaeaea",
        "textLight": "#c9cfdc",
        "textMuted": "#a0aac4",
        "success": "#64ffda",
        "warning": "#ffd93d"
      }
    }
  },
  "typography": {
    "heading": "'Playfair Display', serif",
    "body": "'Inter', sans-serif",
