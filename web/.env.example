# Paragu-AI Builder - Environment Variables
# Copy this file to .env.local and fill in your values.
# For production, set these as Cloudflare Worker secrets:
#   npx wrangler secret put <NAME>

# =============================================================================
# REQUIRED: Supabase Configuration
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# OPTIONAL: Site Configuration
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://paragu-ai.pages.dev
NEXT_PUBLIC_SITE_NAME=Paragu-AI

# =============================================================================
# OBSERVABILITY — Sentry (errors + client RUM)
# =============================================================================
# Enables server + browser Sentry when set. Leave unset for a pure no-op.
# Get DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.1                 # Server performance sampling
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1     # Browser performance sampling
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_RATE=0.1   # Browser session replay rate

# =============================================================================
# OBSERVABILITY — Logging
# =============================================================================
# LOG_LEVEL=info                 # debug | info | warn | error
# LOG_FORMAT=json                # json | pretty (auto by NODE_ENV otherwise)
# SERVICE_NAME=paragu-ai-builder
# SLOW_REQUEST_THRESHOLD_MS=1000
# SLOW_QUERY_THRESHOLD_MS=1000
# NEXT_PUBLIC_APP_VERSION=unknown      # Echoed in service.version + Sentry release
# NEXT_PUBLIC_COMMIT_SHA=                # Preferred over APP_VERSION when both set

# =============================================================================
# OBSERVABILITY — Logpush to Axiom (configured in Cloudflare dashboard)
# =============================================================================
# No env vars needed in the app — Logpush is set up at the Cloudflare level.
# See docs/OBSERVABILITY.md §2 for the step-by-step.

# =============================================================================
# INTEGRATIONS — CRM + Email
# =============================================================================
# These feed lib/integrations/* adapters. Only needed if a tenant site
# declares that adapter in its integrations map.
# CRM_API_KEY=
# CRM_PORTAL_ID=
# CRM_ENDPOINT=
# EMAIL_API_KEY=
# EMAIL_LIST_ID=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
# EMAIL_TRANSACTIONAL_KEY=

# =============================================================================
# OPTIONAL: MercadoPago (for payments)
# =============================================================================
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# =============================================================================
# OPTIONAL: Analytics
# =============================================================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# =============================================================================
# OPTIONAL: External Services
# =============================================================================
# CALENDLY_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# =============================================================================
# DEVELOPMENT: Debug Settings
# =============================================================================
# DEBUG=true
