{
  "id": "yoga",
  "nameEs": "Estudio de Yoga",
  "nameEn": "Yoga Studio",
  "verticalId": "service-booking",
  "extends": "gimnasio",
  "tokens": "yoga",
  "features": {
    "onlineBooking": { "enabled": true, "method": "whatsapp" },
    "classSchedule": { "enabled": true, "filterByType": true, "filterByInstructor": true },
    "membershipPlans": { "enabled": true, "highlightPopular": true },
    "freeTrial": { "enabled": true, "days": 1, "label": "Primera clase gratis" },
    "staffProfiles": { "enabled": true, "label": "Instructores" }
  },
  "serviceCategories": ["hatha", "vinyasa", "yin", "restaurativo", "prenatal", "kids"],
  "seo": {
    "schemaType": "HealthClub",
    "titleTemplate": "{{businessName}} - Yoga en {{city}}",
    "descriptionTemplate": "Clases de yoga en {{city}}. Hatha, Vinyasa, Yin, prenatal y ninos. Primera clase gratis.",
    "keywords": ["yoga {{city}}", "clases yoga {{city}}", "estudio yoga {{city}}", "yoga prenatal {{city}}"]
  },
  "nav": {
    "items": ["Inicio", "Horarios", "Instructores", "Planes", "Contacto"],
    "cta": { "text": "1era Clase Gratis", "action": "freeTrial" }
  },
  "hero": {
    "style": "image",
    "headlineTemplate": "{{businessName}} - Respira. Conecta. Vive.",
    "subheadlineTemplate": "Estudio de yoga en {{city}} con clases para todos los niveles y estilos.",
    "ctaPrimary": { "text": "Primera Clase Gratis", "action": "whatsapp" },
    "ctaSecondary": { "text": "Ver Horarios", "action": "scrollTo:classSchedule" }
  }
}
