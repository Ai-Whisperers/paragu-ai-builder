  },
  "nav": {
    "items": ["Inicio", "Salones", "Paquetes", "Galeria", "Contacto"],
    "cta": { "text": "Cotizar Evento", "action": "quoteForm" }
  },
  "hero": {
    "style": "image",
    "headlineTemplate": "{{businessName}} - El escenario de tus mejores momentos",
