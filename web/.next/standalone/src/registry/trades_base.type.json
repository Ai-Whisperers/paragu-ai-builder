  "hero": {
    "style": "image",
    "headlineTemplate": "{{businessName}}",
    "subheadlineTemplate": "Servicios confiables en {{city}}. Presupuesto gratis.",
    "ctaPrimary": { "text": "Solicitar Presupuesto", "action": "quoteForm" },
    "ctaSecondary": { "text": "WhatsApp", "action": "whatsapp" }
  }
