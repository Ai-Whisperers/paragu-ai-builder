{
  "id": "contador_cooperativa",
  "nameEs": "Contador Especialista en Cooperativas",
  "nameEn": "Cooperative Accounting Specialist",
  "verticalId": "b2b-professional",
  "extends": "contador",
  "tokens": "contador_cooperativa",
  "content": "contador_cooperativa",
  "schema": "contador",
  "icon": "users",
  "pages": {
    "homepage": {
      "sections": [
        "header",
        "hero",
        "servicesPreview",
        "pricingTable",
        "process",
        "about",
        "testimonial",
        "faq",
        "leadForm",
        "footer"
      ],
      "requiredSections": ["header", "hero", "servicesPreview", "contact", "footer"]
    }
  },
  "features": {
    "leadForm": {
      "enabled": true,
      "fields": ["name", "whatsapp", "email", "cooperativaName", "socios", "activos", "message"]
    },
    "pricingDisplay": {
      "enabled": true,
      "showFrom": true
    },
    "languageToggle": {
      "enabled": true,
      "languages": ["es", "de"]
    },
    "whatsappFloat": { "enabled": true },
    "regulatoryBadges": {
      "enabled": true,
      "items": ["CCP", "INCOOP", "SEPRELAD"]
    }
  },
  "serviceCategories": [
    "incoop-reporting",
    "balance-social",
    "asamblea",
    "impuestos-coop",
    "fiscalizaciones"
  ],
  "regulatoryVocab": {
    "primaryRegulator": "INCOOP",
    "taxAuthority": "DNIT",
    "legalFramework": "Ley 438/94 de Cooperativas",
    "keyResolutions": ["Res. INCOOP 4109/09 (Balance Social)"],
    "amlRegulator": "SEPRELAD (para seccion ahorro-credito)"
  },
  "targetAudience": {
    "primary": "Cooperativas de produccion, consumo, ahorro y credito en Paraguay",
    "secondary": "Cooperativas escolares y mixtas",
    "tertiary": "Cooperativas del Chaco con miembros mennonitas"
  },
  "seo": {
    "schemaType": "AccountingService",
    "titleTemplate": "{{businessName}} - Contador para Cooperativas | INCOOP + Balance Social",
    "descriptionTemplate": "Contabilidad especializada en cooperativas paraguayas: estados INCOOP, Balance Social Cooperativo, asamblea, auditoria externa. Matriculados CCP.",
    "keywords": [
      "contador cooperativa {{city}}",
      "balance social cooperativo",
      "INCOOP reporting",
      "auditoria externa cooperativa",
      "asamblea cooperativa paraguay",
      "Res INCOOP 4109/09"
    ]
  },
  "nav": {
    "items": ["Inicio", "Servicios", "Planes", "Proceso", "FAQ", "Contacto"],
    "cta": { "text": "Agendar Reunion", "action": "leadForm" }
  },
  "hero": {
    "style": "minimal",
    "headlineTemplate": "{{businessName}} - Contabilidad para Cooperativas",
    "subheadlineTemplate": "INCOOP, Balance Social, asamblea y cumplimiento tributario para cooperativas paraguayas.",
    "ctaPrimary": { "text": "Agendar Reunion", "action": "leadForm" },
    "ctaSecondary": { "text": "Ver Servicios", "action": "scrollTo:services" }
  }
}
