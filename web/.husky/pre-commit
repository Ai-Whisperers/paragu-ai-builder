#!/bin/sh
#
# Pre-commit hook for Paragu-AI Builder
# Runs lint-staged to check and fix code before commit
#

. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run typecheck
echo "📦 Type checking..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Please fix the errors above."
  exit 1
fi

# Run lint-staged
echo "🔧 Running lint-staged..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Lint-staged failed. Please fix the errors above."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
