{
  "name": "paragu-ai-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "prebuild": "npm run generate:renderer && npm run generate:tenant-data && npm run copy:tenant-images",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "copy:tenant-images": "node scripts/copy-tenant-images.mjs",
    "generate:tenant-data": "tsx scripts/generate-tenant-data.ts",
    "export:email-nurture": "tsx scripts/export-email-nurture.ts",
    "export:content-calendar": "tsx scripts/export-content-calendar.ts",
    "generate:renderer": "tsx scripts/generate-renderer-map.ts",
    "convert:tenant-images": "tsx scripts/convert-tenant-images.ts",
    "validate:tenant-images": "tsx scripts/validate-tenant-images.ts",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "vitest run tests/unit tests/integration",
    "test:ci": "vitest run tests/unit tests/integration --coverage",
    "test:all": "npm run test:ci && npm run test:e2e",
    "test:unit": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "test:coverage:html": "vitest run --coverage --coverage.reporter=html",
    "validate:schemas": "node scripts/validate-registry-schemas.ts",
    "validate:tokens": "npx tsx scripts/validate-tokens.ts",
    "validate:sites": "npx tsx scripts/validate-sites.ts",
    "validate:vertical": "npx tsx scripts/validate-vertical.ts",
    "validate:content": "npx tsx scripts/validate-content.ts",
    "validate:legal": "npx tsx scripts/legal-review-gate.ts",
    "validate:contrast": "npx tsx scripts/contrast-audit.ts",
    "validate:all": "npm run validate:sites && npm run validate:content && npm run validate:legal && npm run validate:vertical relocacion && npm run validate:vertical service-booking && npm run validate:vertical hospitality && npm run validate:vertical portfolio-professional",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "generate:site": "npx tsx scripts/generate-site.ts",
    "generate:preview": "npx tsx scripts/generate-preview.ts",
    "create-type": "npx tsx scripts/create-type.ts",
    "cli": "npx tsx scripts/cli.ts",
    "generate:config": "npx tsx scripts/generate-static-config.ts",
    "validate:registry": "npx tsx scripts/validate-registry.ts",
    "import:leads": "npx tsx scripts/import-leads.ts",
    "import:leads:extended": "npx tsx scripts/import-leads-extended.ts",
    "report:funnel": "npx tsx scripts/funnel-report.ts",
    "report:cities": "npx tsx scripts/city-breakdown.ts",
    "report:verticals": "npx tsx scripts/vertical-analysis.ts",
    "deploy:setup": "npx tsx scripts/deploy-setup.ts",
    "production:health": "npx tsx scripts/production-health-check.ts",
    "production:status": "npx tsx scripts/production-status.ts",
    "wire:integrations": "npx tsx scripts/wire-integrations.ts",
    "add-tenant": "node ../tools/add-paragu-ai-tenant.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@sentry/nextjs": "^10.52.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.10",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lru-cache": "^10.4.3",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@next/bundle-analyzer": "^16.2.4",
    "@opennextjs/cloudflare": "^1.19.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vite": "^8.0.9",
    "vitest": "^4.1.4",
    "wrangler": "^4.84.0"
  }
}