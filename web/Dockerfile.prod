FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME="0.0.0.0"
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
COPY --chown=nextjs:nodejs web/.next/standalone ./
COPY --chown=nextjs:nodejs web/.next/static ./.next/static
COPY --chown=nextjs:nodejs web/public ./public
COPY --chown=nextjs:nodejs web/docker-start.sh ./
RUN chmod +x docker-start.sh && \
    chown nextjs:nodejs docker-start.sh
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1
USER nextjs
EXPOSE 3000
CMD ["./docker-start.sh"]
