FROM node:20-slim
WORKDIR /app
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy the pre-built standalone output
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/server/ ./
COPY --chown=nextjs:nodejs .next/static ./static
COPY --chown=nextjs:nodejs .next/image-optimization-data.json ./
COPY --chown=nextjs:nodejs public ./public

# Copy package files for startup script
COPY --chown=nextjs:nodejs package.json .next/package.json ./

# Copy start script
COPY --chown=nextjs:nodejs docker-start.sh .
RUN chmod +x docker-start.sh

USER nextjs
EXPOSE 3000
ENV NODE_ENV=production PORT=3000
CMD ["node", "server.js"]
