{
  "extends": "base",
  "theme": "light",
  "mood": ["warm", "intimate", "soft", "cozy", "lo-fi", "vintage"],
  "palettes": {
    "optionA": {
      "name": "Warm Amber / Cream",
      "colors": {
        "primary": "#b45309",
        "secondary": "#d97706",
        "accent": "#fcd34d",
        "background": "#fffbeb",
        "surface": "#fef3c7",
        "surfaceLight": "#fef9c3",
        "text": "#292524",
        "textLight": "#57534e",
        "textMuted": "#a8a29e",
        "success": "#16a34a",
        "error": "#dc2626",
        "warning": "#d97706",
        "secondaryHover": "#f59e0b"
      }
    },
    "optionB": {
      "name": "Twilight Indigo",
      "colors": {
        "primary": "#4338ca",
        "secondary": "#6366f1",
        "accent": "#fbbf24",
        "background": "#faf5ff",
        "surface": "#f3e8ff",
        "surfaceLight": "#ede9fe",
        "text": "#1c1917",
        "textLight": "#57534e",
        "textMuted": "#a8a29e",
        "success": "#16a34a",
        "error": "#dc2626",
        "warning": "#f59e0b",
        "secondaryHover": "#818cf8"
      }
    }
  },
  "defaultPalette": "optionA",
  "typography": {
    "heading": "'Playfair Display', Georgia, 'Times New Roman', serif",
    "body": "'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "accent": "'Inter', sans-serif",
    "headingWeight": "600",
    "bodyWeight": "400",
    "headingStyle": "normal",
    "textTransform": "none",
    "lineHeight": {
      "heading": "1.2",
      "body": "1.7",
      "relaxed": "1.9"
    },
    "letterSpacing": {
      "heading": "0",
      "body": "0",
      "wide": "0.02em"
    },
    "fontSize": {
      "h1": "clamp(2.5rem, 6vw, 4.5rem)",
      "h2": "clamp(1.75rem, 4vw, 3rem)",
      "h3": "clamp(1.25rem, 2.5vw, 1.75rem)",
      "body": "1rem"
    }
  },
  "spacing": {
    "section": {
      "desktop": "96px",
      "tablet": "64px",
      "mobile": "40px"
    },
    "contentGap": "24px",
    "cardPadding": "24px"
  },
  "effects": {
    "heroOverlay": "linear-gradient(rgba(255,251,235,0.92), rgba(254,243,199,0.6))",
    "cardHover": "0 4px 20px rgba(180,83,9,0.10)",
    "glitch": {"enabled": false},
    "noise": {"enabled": false},
    "borderGlow": "0 0 4px rgba(180,83,9,0.15)",
    "dividerStyle": "solid 1px rgba(180,83,9,0.1)"
  },
  "images": {
    "hero": { "width": 1920, "height": 1080, "maxSizeKb": 200 },
    "gallery": { "width": 1200, "height": 1200, "maxSizeKb": 150 },
    "thumbnail": { "width": 400, "height": 400, "maxSizeKb": 50 },
    "format": "webp",
    "fallbackFormat": "jpeg"
  },
  "cssCustom": "--section-divider: linear-gradient(90deg, transparent, rgba(180,83,9,0.15), transparent); --glow-primary: 0 0 10px rgba(180,83,9,0.15); --header-bg: rgba(255,251,235,0.95); --border-color: rgba(180,83,9,0.12); --font-lyrics: 'EB Garamond', Georgia, serif; --track-hover-bg: rgba(180,83,9,0.04);"
}
